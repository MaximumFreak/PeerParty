<Project Sdk="Microsoft.NET.Sdk">
  <!-- PPTEST_PHOTON_DIR: a folder with copies of a game's Photon3Unity3D.dll,
       PhotonRealtime.dll and, if the game has it, PhotonChat.dll (a Unity game's
       <Game>_Data\Managed). Without PhotonChat.dll the Chat part is left out. -->
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net9.0</TargetFramework><ImplicitUsings>disable</ImplicitUsings><PlatformTarget>x64</PlatformTarget></PropertyGroup>
  <PropertyGroup Condition="Exists('$(PPTEST_PHOTON_DIR)\PhotonChat.dll')"><DefineConstants>$(DefineConstants);HAS_CHAT</DefineConstants></PropertyGroup>
  <ItemGroup>
    <Reference Include="Photon3Unity3D"><HintPath>$(PPTEST_PHOTON_DIR)\Photon3Unity3D.dll</HintPath></Reference>
    <Reference Include="PhotonRealtime"><HintPath>$(PPTEST_PHOTON_DIR)\PhotonRealtime.dll</HintPath></Reference>
    <Reference Include="PhotonChat" Condition="Exists('$(PPTEST_PHOTON_DIR)\PhotonChat.dll')"><HintPath>$(PPTEST_PHOTON_DIR)\PhotonChat.dll</HintPath></Reference>
    <ProjectReference Include="..\UnityEngine\UnityEngine.csproj" />
    <ProjectReference Include="..\UnityEngine.CoreModule\UnityEngine.CoreModule.csproj" />
  </ItemGroup>
</Project>